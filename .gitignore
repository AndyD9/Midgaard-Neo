# Dépendances
node_modules/

# Sorties de compilation : `npm run build` les régénère
dist/
*.tsbuildinfo
# La coque desktop, construite par `npm run desktop:build`
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
# Ce que l'application autonome embarque, assemblé par `npm run desktop:stage`
apps/desktop/src-tauri/runtime/

# État runtime du harness. Il vit normalement dans ~/.midgaard ;
# ces entrées couvrent un MIDGAARD_HOME pointé dans le dépôt.
.midgaard/
.runtime*/

# Système
.DS_Store
